# Copiá este archivo como ".env" y completá tus propios valores.
# El archivo ".env" NO se sube a Git: ahí van tus datos reales.

# Clave secreta de Django. Generá una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Si queda vacía se usa una clave solo para desarrollo (no sirve en producción).
SECRET_KEY=

# True = modo desarrollo (por defecto). En producción poné False.
DEBUG=True

# Dominios permitidos, separados por comas. Vacío sirve en desarrollo local.
# Ejemplo en producción: midominio.com,www.midominio.com
ALLOWED_HOSTS=

# Cuenta de Gmail desde la que se envían los mensajes del formulario de contacto.
EMAIL_HOST_USER=tu_correo@gmail.com

# Contraseña de aplicación de Google (no la contraseña normal de la cuenta).
EMAIL_HOST_PASSWORD=

# True = envía correos de verdad por Gmail.
# Vacío o False = los correos se imprimen en la terminal (modo desarrollo).
EMAIL_REAL=False
